# --- Multi-key rotation (comma-separated) ---
# 10 free Gemini API keys for rate-limit avoidance
GEMINI_API_KEYS=gemini-key-1,gemini-key-2,gemini-key-3,gemini-key-4,gemini-key-5,gemini-key-6,gemini-key-7,gemini-key-8,gemini-key-9,gemini-key-10

# Multiple Groq API keys (primary LLM provider)
GROQ_API_KEYS=groq-key-1,groq-key-2,groq-key-3

# Legacy single Gemini key (backward compatible, merged into pool)
GEMINI_API_KEY=

# --- Infrastructure ---
CHROMA_HOST=chromadb
REDIS_URL=redis://redis:6379
MONGO_URL=mongodb://mongodb:27017/nexus_chat
DATABASE_URL=postgresql://nexus_user:nexus_pass@postgres:5432/nexus_db
JWT_SECRET=change-this-to-a-long-random-string-minimum-32-chars
