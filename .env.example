# -----------------------------------------------------------------------------
# Example environment variables (SANITIZED)
# Replace placeholder values before use. Do NOT commit real secrets.
# -----------------------------------------------------------------------------
POSTGRES_DB=Project_nexus
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_DB_PASSWORD
DATABASE_URL=postgresql://postgres:REPLACE_WITH_DB_PASSWORD@localhost:5432/Project_nexus
JWT_SECRET=REPLACE_WITH_JWT_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# Infrastructure
REDIS_URL=redis://redis:6379
KAFKA_BROKER=kafka:9092
MONGO_URL=mongodb://localhost:27017/testdb
CHROMA_HOST=chromadb
CHROMA_PORT=8000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_GRAFANA_PASSWORD
NEXUS_INTERNAL_API_KEY=REPLACE_WITH_INTERNAL_API_KEY

# AI / LLM
GEMINI_API_KEY=
GEMINI_API_KEYS=
GROQ_API_KEYS=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Frontend build-time config
VITE_API_URL=/api/v1
