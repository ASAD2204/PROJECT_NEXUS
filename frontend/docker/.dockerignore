# Ignore node_modules
node_modules/

# Ignore development files
.git
.gitignore
.env
.env.local
.env.development
.env.test
.env.production

# Ignore build output (we build inside container)
dist/
build/

# Ignore documentation
*.md
!README.md

# Ignore IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Ignore logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore test files
coverage/
.nyc_output/

# Ignore docker files from being copied recursively
docker/
Dockerfile
docker-compose.yml
.dockerignore
